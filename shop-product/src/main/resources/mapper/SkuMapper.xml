<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.spring.shopproduct.mapper.SkuMapper">
    <select id="selectShelfLifeDays" resultType="java.lang.Integer">
        SELECT p.shelf_life_days
        FROM product_sku s JOIN product_spu p ON p.id = s.product_id
        WHERE s.id = #{skuId}
    </select>
    <sql id="visibleSkuTables">
        FROM product_sku s
        JOIN product_spu p ON p.id = s.product_id
        JOIN category c ON c.id = p.category_id
        WHERE s.enabled = 1 AND p.status = 'ON_SALE' AND c.enabled = 1
    </sql>
    <select id="selectVisibleById" resultType="org.spring.shopproduct.entity.SkuEntity">
        SELECT s.id, s.product_id, s.sku_code, s.spec_name, s.weight_gram, s.price_fen, s.enabled, s.version
        <include refid="visibleSkuTables"/>
        AND s.id = #{skuId}
    </select>
    <resultMap id="cartMetadata" type="org.spring.shopproduct.vo.CartSkuVO">
        <constructor>
            <idArg column="id" javaType="string"/>
            <arg column="product_name" javaType="string"/>
            <arg column="spec_name" javaType="string"/>
            <arg column="price_fen" javaType="_long"/>
            <arg column="weight_gram" javaType="_int"/>
        </constructor>
    </resultMap>
    <select id="selectCartMetadata" resultMap="cartMetadata">
        SELECT s.id, p.name AS product_name, s.spec_name, s.price_fen, s.weight_gram
        <include refid="visibleSkuTables"/>
        AND s.id IN
        <foreach collection="skuIds" item="skuId" open="(" separator="," close=")">#{skuId}</foreach>
    </select>
    <resultMap id="quoteLine" type="org.spring.shopcommon.checkout.ProductQuote$Line">
        <constructor>
            <idArg column="id" javaType="string"/>
            <arg column="product_id" javaType="string"/>
            <arg column="product_name" javaType="string"/>
            <arg column="spec_name" javaType="string"/>
            <arg column="weight_gram" javaType="long"/>
            <arg column="price_fen" javaType="long"/>
            <arg column="product_version" javaType="long"/>
            <arg column="sku_version" javaType="long"/>
        </constructor>
    </resultMap>
    <select id="selectQuoteLines" resultMap="quoteLine">
        SELECT s.id, s.product_id, p.name AS product_name, s.spec_name, s.weight_gram, s.price_fen,
               p.version AS product_version, s.version AS sku_version
        <include refid="visibleSkuTables"/>
        AND s.id IN
        <foreach collection="skuIds" item="skuId" open="(" separator="," close=")">#{skuId}</foreach>
        ORDER BY s.id
    </select>
    <!-- 利用 product_id/enabled 索引过滤，不复用管理端持锁且包含禁用规格的查询。 -->
    <select id="selectEnabledByProduct" resultType="org.spring.shopproduct.entity.SkuEntity">
        SELECT id,product_id,sku_code,spec_name,weight_gram,price_fen,enabled,version
        FROM product_sku WHERE product_id=#{productId} AND enabled=1 ORDER BY id
    </select>
    <!-- 当前读避免重复读快照中的旧状态；共享锁防止校验后规格被禁用/删除。 -->
    <select id="selectByProductForShare" resultType="org.spring.shopproduct.entity.SkuEntity">
        SELECT id,product_id,sku_code,spec_name,weight_gram,price_fen,enabled,version
        FROM product_sku WHERE product_id=#{productId} ORDER BY id FOR SHARE
    </select>
    <!-- 参数绑定避免 SQL 注入；初始版本固定为 1，不接收外部版本或库存。 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product_sku(product_id,sku_code,spec_name,weight_gram,price_fen,enabled,version)
        VALUES (#{productId},#{skuCode},#{specName},#{weightGram},#{priceFen},#{enabled},1)
    </insert>
</mapper>
