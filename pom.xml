<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 基础层负责版本、Lombok、测试和构建插件。本层为业务服务提供数据库依赖。 -->
    <parent>
        <groupId>com.dong</groupId>
        <artifactId>shop-base-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>shop-base-parent/pom.xml</relativePath>
    </parent>

    <groupId>com.dong</groupId>
    <artifactId>shop</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <!-- 默认仍继承原 MyBatis；需要 Plus 的业务模块只覆盖这三个坐标，不改变父子 POM 架构。 -->
        <shop.mybatis.starter-group-id>org.mybatis.spring.boot</shop.mybatis.starter-group-id>
        <shop.mybatis.starter-artifact-id>mybatis-spring-boot-starter</shop.mybatis.starter-artifact-id>
        <shop.mybatis.starter-version>${mybatis-spring-boot.version}</shop.mybatis.starter-version>
    </properties>

    <!-- 默认继承：user/product/cart/order/pay 自动引入，不需重复声明。
         Lombok 与测试依赖也会从基础父 POM 一并继承。
         gateway/common 直接继承基础父 POM，隔离本层数据库依赖。 -->
    <dependencies>
        <dependency>
            <groupId>${shop.mybatis.starter-group-id}</groupId>
            <artifactId>${shop.mybatis.starter-artifact-id}</artifactId>
            <version>${shop.mybatis.starter-version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
    </dependencies>

    <!-- 保留版本管理/按需引入模式：这里仅管理版本。
         上面的 dependencies 决定哪些依赖自动引入；
         以后只想按需引入的库，仅放在这里，由子模块声明。
         Web、Nacos、Sentinel 等版本继续由基础父 POM 的 BOM 管理。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 聚合构建与 parent 继承相互独立；base/common/gateway 仍参与根项目构建。 -->
    <modules>
        <module>shop-base-parent</module>
        <module>shop-common</module>
        <module>shop-cache</module>
        <module>shop-messaging</module>
        <module>shop-user</module>
        <module>shop-gateway</module>
        <module>shop-product</module>
        <module>shop-cart</module>
        <module>shop-order</module>
        <module>shop-pay</module>
    </modules>
</project>
